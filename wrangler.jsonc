{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallball",
  "compatibility_date": "2026-09-30",
  "main": "worker/index.js",
  "assets": {
    "directory": "./web-dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/wallball",
      "/wallball/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
